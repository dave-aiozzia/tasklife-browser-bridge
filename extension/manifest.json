{
  "manifest_version": 3,
  "name": "Tasklife Browser Bridge",
  "description": "Connect your local Chrome session to an approved agent backend for safe browser assistance.",
  "version": "0.1.0",
  "permissions": ["activeTab", "sidePanel", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Tasklife Browser Bridge"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
